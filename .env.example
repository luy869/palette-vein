# 本番環境用の環境変数。.env にコピーして値を設定してください。
# .env は .gitignore 済み（コミットされません）。

# Docker Compose のプロジェクト名。古い docker compose は -p 前置を受け付けないため
# ここで固定し、start.sh/stop.sh/ps/logs/down すべてで同じプロジェクトを解決させる。
COMPOSE_PROJECT_NAME=palettevein

# JWT署名シークレット（openssl rand -hex 32 で生成）
JWT_SECRET=change_me_to_a_random_secret

# PostgreSQL のパスワード（本番用に強力な値を。openssl rand -hex 24 等）
POSTGRES_PASSWORD=change_me_strong_password

# 埋め込みワーカーの画像DL間隔(ms)。未設定なら 300。CDN負荷を見て調整可。
EMBED_DELAY_MS=300

# Secure Cookie。Cloudflare Tunnel 経由(HTTPS)の本番は true（未設定なら true）。
# ローカルHTTP(127.0.0.1:8090)で疎通テストする間だけ false にする。
# SECURE_COOKIE=false

# CORSオリジン。フロントを同一オリジン（nginx の /api プロキシ）で配信する標準構成では不要。
# フロントを別オリジンから配信する場合のみ設定（カンマ区切りで複数可）。
# ALLOWED_ORIGIN=https://palettevein.example.com
